#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

mix hex.build --unpack --output "$workdir/package"
RUST_FONTCONFIG_DLOPEN="${RUST_FONTCONFIG_DLOPEN:-1}" mix docs --warnings-as-errors
mix hex.audit

(
  cd "$workdir/package"
  MIX_ENV=prod mix deps.get
  RUST_FONTCONFIG_DLOPEN="${RUST_FONTCONFIG_DLOPEN:-1}" \
    MIX_ENV=prod mix compile --warnings-as-errors
)
