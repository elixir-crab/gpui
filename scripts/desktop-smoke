#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

for command in xvfb-run dbus-run-session xdotool; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "desktop E2E dependency not found: $command" >&2
    exit 1
  fi
done

if ! python3 -c "import Xlib" >/dev/null 2>&1; then
  echo "desktop E2E dependency not found: python3-xlib" >&2
  exit 1
fi

export RUST_FONTCONFIG_DLOPEN="${RUST_FONTCONFIG_DLOPEN:-1}"
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/usr/share/vulkan/icd.d/lvp_icd.json}"
export GPUI_E2E=1
export MIX_ENV=test
export MIX_BUILD_PATH="${MIX_BUILD_PATH:-_build/e2e}"

mix compile --force --warnings-as-errors

timeout 300s xvfb-run -a -s "-screen 0 1280x720x24" \
  dbus-run-session -- mix test --only e2e test/e2e
